[gd_resource type="Resource" script_class="ContinentData" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/models/continent_data.gd" id="1_cont"]

[resource]
script = ExtResource("1_cont")
id = &"CONT-01"
display_name = "Veyrath"
description = "Continente vulcânico calcinado pelo fogo abissal. Terras cobertas de cinzas, rios de magma e montanhas de basalto negro esculpidas em pactos ancestrais."
