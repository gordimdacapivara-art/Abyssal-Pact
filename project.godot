; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Abyssal Pact"
config/description="RPG de ação em terceira pessoa — Dark Fantasy 3D. Multiplayer exclusivamente privado (máx. 8 jogadores por mundo, anfitrião incluído)."
config/tags=PackedStringArray("game")
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[input]

