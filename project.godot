[autoload]

EventBus="*res://core/event_bus.gd"
Scenes="*res://autoload/scene_manager.gd"
UI="*res://autoload/ui_manager.tscn"
Audio="*res://autoload/audio_manager.tscn"
Net="*res://autoload/multiplayer_manager.gd"
Save="*res://autoload/save_manager.gd"
Game="*res://autoload/game_manager.gd"

[rendering]

anti_aliasing/quality/msaa_3d=2
occlusion_culling/use_occlusion_culling=true
mesh_lod/lod_change/threshold_pixels=1.0
textures/vram_compression/import_etc2_astc=true

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=9.8

[animation]

warnings/check_invalid_track_paths=false
